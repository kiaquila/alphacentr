{
  "name": "alphacentr-site",
  "version": "1.0.0",
  "private": true,
  "description": "Alpha Lumen — static redesign of the Alpha-Centr hypnosis practice website",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run build && npm run serve",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run build && npm test",
    "stage:deploy": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "stage:preview": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler versions upload"
  },
  "devDependencies": {
    "wrangler": "4.119.0"
  }
}
