# Harness trust boundary. Enable required Code Owner review in the ruleset.
/.github/ @kiaquila
/docs/ @kiaquila
/scripts/ @kiaquila
/tests/ @kiaquila
/web-design.config.json @kiaquila
# ci.yml runs `npm run preflight` directly, so these manifests decide whether
# the guard runs at all — they belong inside the same trust boundary.
/package.json @kiaquila
/package-lock.json @kiaquila
/site/package.json @kiaquila
# npm config can replace the shell that runs those scripts. The guard refuses a
# tracked .npmrc outright; these entries cover the file if that ever changes.
/.npmrc @kiaquila
/site/.npmrc @kiaquila
