{
  "schemaVersion": 1,
  "project": {
    "slug": "alphacentr",
    "profile": "static-cloudflare",
    "productPaths": [
      "site"
    ]
  },
  "commands": {
    "check": [
      {
        "name": "project-check",
        "run": "npm --prefix site run check"
      }
    ]
  },
  "deployment": {
    "provider": "cloudflare-workers",
    "productionBranch": "main",
    "rootDirectory": "site"
  },
  "governance": {
    "source": "kiaquila/web-design",
    "channel": "v1",
    "mode": "consumer"
  },
  "requiredChecks": [
    "project-ci",
    "repository-guard",
    "baseline-source-verification",
    "osv-scan",
    "Codex Review"
  ]
}
